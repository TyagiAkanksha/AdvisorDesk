# AdvisorDesk — environment template (PRD §9). Copy to .env and fill in real values.
# Real .env files are gitignored; only this file is tracked. Never commit secrets.

# LLM provider switch (v1.6, task 6R-14) — "openai" (default) or "nvidia". Both NVIDIA NIM
# models this app was originally pinned to went end-of-life (410 Gone) on 2026-08-25/26; OpenAI
# is now the default live provider (PRD §7.2 v1.6). Selects which API-key field below
# (OPENAI_API_KEY vs NVIDIA_API_KEY) the embedding/chat/agent clients authenticate with.
LLM_PROVIDER=openai

# OpenAI API key — chat completions (RAG assistant, agent loop) + embeddings (PRD §7.2 v1.6).
# Required when LLM_PROVIDER=openai (the default). Get one at https://platform.openai.com
OPENAI_API_KEY=
# NVIDIA API key — only needed when LLM_PROVIDER=nvidia (back-compat/future-re-enable branch).
# Free keys: https://build.nvidia.com
NVIDIA_API_KEY=
# Provider tunables (defaults shown are the OpenAI values; a provider swap is config-only —
# PRD §7.2). NVIDIA equivalents (LLM_PROVIDER=nvidia): LLM_BASE_URL=
# https://integrate.api.nvidia.com/v1, EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5,
# CHAT_MODEL=meta/llama-3.1-8b-instruct — both EOL'd 2026-08-25/26, kept here only as the
# back-compat branch's values, not recommended for new deployments.
LLM_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024
# Embedding-request client budget (phase-3 task-02 review round 1, finding I1; not in the
# original PRD §9 roster) — bounds a single embedding call/attempt and how many times the SDK
# retries a failed one, so a stalled provider can't hold a publish's DB transaction open for the
# openai SDK's own much larger defaults (read=600s, max_retries=2, ~30 minutes across 3 attempts).
EMBEDDING_TIMEOUT_SECONDS=30.0
EMBEDDING_MAX_RETRIES=2
# Chat-completion model for the client assistant's answer synthesis (PRD §7.5) and the admin
# agent loop (§5.4) — same OpenAI-compatible endpoint as LLM_BASE_URL above. `gpt-4o-mini`
# (PRD §7.2 v1.6) — controller-verified live, supports tool-calling (the admin agent needs it);
# a provider swap is config-only, same principle as EMBEDDING_MODEL.
CHAT_MODEL=gpt-4o-mini

# Postgres/pgvector connection string — Supabase by default, or the local-db compose profile (PRD §9).
DATABASE_URL=

# Google OAuth client id — admin login (PRD §5.1). Only needed to exercise admin login in dev
# (leave empty and the app still boots; login just won't work until this is set); required
# and enforced at boot (app.main raises if empty) in production.
GOOGLE_CLIENT_ID=

# Google OAuth client secret — admin login (PRD §5.1). Same dev-optional/production-required
# rule as GOOGLE_CLIENT_ID above.
GOOGLE_CLIENT_SECRET=

# Google-console-registered OAuth callback URL, e.g. https://api.example.com/api/v1/auth/callback
# (phase-2 task-01; not in the original PRD §9 roster — required by the real
# httpx Google OAuth client to exchange an authorization code). Same dev-optional/
# production-required rule as GOOGLE_CLIENT_ID above; defaults here to the local dev value.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Secret used to sign the HttpOnly admin session cookie (PRD §9). Required in every
# environment, including dev (app.main raises at boot if empty — an empty/known signing key
# is fail-open and never allowed). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# "development" (default) or "production" — gates the session cookie's Secure flag
# (phase-2 task-01; not in the original PRD §9 roster). Set to "production" in any
# real deployment so the admin session cookie is only ever sent over HTTPS.
ENVIRONMENT=development

# Admin SPA origin (phase-2 task-01 review M8 resolution; not in the original PRD §9
# roster). On success, GOOGLE_REDIRECT_URI's handler (/auth/callback) 303-redirects here
# so the browser lands back in the admin app after Google sign-in. Defaults to the local
# admin dev server; a real deployment sets this to the admin app's real origin.
ADMIN_APP_URL=http://localhost:3001

# Base URL of apps/api that apps/admin targets (phase-2 task-04; mirrored in
# apps/admin/.env.local.example, which apps/admin actually loads via Next.js —
# this root copy documents the value for the API-side vars above to line up
# against). Must be an origin CORS_ORIGINS below allows. Required at build
# time in production (apps/admin/src/lib/apiBase.ts throws if unset when
# NODE_ENV=production); defaults to the local dev API origin otherwise.
#
# BUILD-TIME, CLIENT-SIDE var (the `NEXT_PUBLIC_` prefix inlines it into the browser bundle at
# build time) — apps/admin's own RTK Query base URL and OAuth anchor href both need the value
# in the browser, since admin renders interactively.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL of apps/api that apps/client targets (phase-3 task-04; apps/client/src/lib/
# publicApi.ts). Deliberately NOT `NEXT_PUBLIC_`-prefixed: apps/client's content pages are React
# Server Components that fetch server-side only (docs/FRONTEND-CONVENTIONS.md §6) — the value
# never needs to reach the browser bundle, so a plain server-side env var is the right shape
# (contrast with NEXT_PUBLIC_API_URL above, which apps/admin's client-rendered UI does need
# inlined at build time). Required at build/runtime in production (apps/client/src/lib/
# publicApi.ts throws if unset when NODE_ENV=production); defaults to the local dev API origin
# otherwise.
API_URL=http://localhost:8000

# Comma-separated allowlist of admin emails accepted by the Google OAuth callback (PRD §9).
ADMIN_EMAILS=

# Comma-separated allowed CORS origins — the two frontend origins; no wildcard in deployed envs
# (PRD §9). Defaults to the two local dev origins (client 3000, admin 3001 — pinned ports, see
# docs/FRONTEND-CONVENTIONS.md §1) so CORS is live out of the box after `cp .env.example .env`;
# a real deployment sets this to the deployed frontend origins instead. An empty value is legal
# (same-origin deployments never need CORS) — `app.main` logs a boot-time warning, not an error,
# when it's blank, since a same-origin deploy without the two local dev origins is not a bug.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Minimum cosine similarity (1 - <=> distance) for a retrieved chunk to be kept (PRD §7.3). Default: 0.35
SIMILARITY_THRESHOLD=0.35

# Public chat rate limit: messages per minute per IP (PRD §9). Default: 10
RATE_LIMIT_PER_MIN=10

# Public chat rate limit: messages per day per session (PRD §9). Default: 50
RATE_LIMIT_PER_DAY=50

# Public chat rate limit: new sessions per day per IP (PRD §9). Default: 20
SESSION_CREATE_PER_DAY=20

# Expose the MCP server over HTTP for external MCP clients (PRD §3). Default: false
MCP_HTTP_ENABLED=false

# Dev/test only — throwaway-schema Postgres/pgvector URL for the test suite (CONVENTIONS.md §10).
# Point it at a DEDICATED database (e.g. .../advisordesk_test), never the dev database:
# SQLAlchemy's inspector resolves tables by name, so a same-named table in the dev `public`
# schema collides with the throwaway test schema (MultipleResultsFound).
# TEST_DATABASE_URL=
