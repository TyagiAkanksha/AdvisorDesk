# apps/admin environment template (task-04). Copy to .env.local (gitignored;
# Next.js loads it automatically) and fill in real values for local dev.
# See also the root .env.example for the API-side vars (CORS_ORIGINS,
# ADMIN_APP_URL, GOOGLE_*) this must line up with.

# Base URL of apps/api that baseApi (src/lib/api/baseApi.ts) targets. Sent
# with credentials:'include' so the HttpOnly admin session cookie round-trips
# (PRD §9) — must be an origin CORS_ORIGINS (root .env.example) allows.
# Also drives SignInScreen's Google OAuth link (`${NEXT_PUBLIC_API_URL}/api/v1/auth/login`).
NEXT_PUBLIC_API_URL=http://localhost:8000
