# apps/client environment template (final review, phase-3 fix wave, F1). Copy to .env.local
# (gitignored; Next.js loads it automatically) and set a real value for local dev if the default
# doesn't match your setup. NOTE: Next.js reads THIS file (apps/client/.env.local), not the repo
# root .env — the root .env.example documents the same API_URL value for reference only, so the
# API-side vars there and this app's own value line up.

# Base URL of apps/api that this app's server-only fetch helper (src/lib/publicApi.ts) targets.
# Deliberately NOT NEXT_PUBLIC_-prefixed: apps/client's content pages are React Server
# Components that fetch server-side only (docs/FRONTEND-CONVENTIONS.md §6) — the value never
# needs to reach the browser bundle. Falls back to http://localhost:8000 in dev/test when unset;
# required in production builds (`next build`/`next start` with NODE_ENV=production) — see
# publicApi.ts's `resolveApiBaseUrl`. infra/Dockerfile.web + infra/docker-compose.yml's `client`
# service set this explicitly for the container build/runtime (container-network origin
# `http://api:8000`, not localhost).
API_URL=http://localhost:8000

# Base URL of apps/api that the chat screen's hand-rolled SSE hook (src/components/chat/
# useChatStream.ts) targets. BUILD-TIME, CLIENT-SIDE var (task-05, phase-4) — unlike API_URL
# above, `useChatStream` runs in the BROWSER (it's a `'use client'` island, docs/
# FRONTEND-CONVENTIONS.md §6), so it needs a `NEXT_PUBLIC_`-prefixed var the same way
# apps/admin/.env.local.example's NEXT_PUBLIC_API_URL does for that app's RTK Query base URL —
# Next.js only inlines `NEXT_PUBLIC_*` vars into the client bundle at build time. Same
# dev-fallback/production-required rule as API_URL above (see useChatStream.ts's
# `resolveApiBaseUrl`). infra/Dockerfile.web already declares NEXT_PUBLIC_API_URL as a shared
# build ARG for both apps/admin and apps/client (one Dockerfile, `--build-arg APP=`), and
# infra/docker-compose.yml's `client` service already passes it through — no infra changes were
# needed for this task.
NEXT_PUBLIC_API_URL=http://localhost:8000
